@using ArenaQuiz.Shared.Functional
@using ArenaQuiz.Shared.Models

<section class="aq-card" aria-label="Live leaderboard">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.85rem;">
        <div>
            <h3 style="margin:0; font-size:1.08rem; font-weight:700;">Live Standings</h3>
            <div style="font-size:0.82rem; color:var(--text-secondary);">
                @Players.Count @(Players.Count == 1 ? "participant" : "participants")
            </div>
        </div>

        @if (Mode == GameMode.TeamBattle && Teams.Count > 0)
        {
            <div style="display:inline-flex; gap:0.35rem;">
                <button type="button"
                        class="aq-btn aq-btn-sm @(!_showTeams ? "aq-btn-dark" : "aq-btn-secondary")"
                        @onclick="() => _showTeams = false">
                    Players
                </button>
                <button type="button"
                        class="aq-btn aq-btn-sm @(_showTeams ? "aq-btn-dark" : "aq-btn-secondary")"
                        @onclick="() => _showTeams = true">
                    Teams
                </button>
            </div>
        }
    </div>

    @if (_showTeams && Mode == GameMode.TeamBattle && Teams.Count > 0)
    {
        <div style="display:flex; flex-direction:column; gap:0.55rem;">
            @for (int i = 0; i < Teams.Count; i++)
            {
                var team = Teams[i];
                <div class="aq-leaderboard-row">
                    <div style="display:flex; align-items:center; gap:0.75rem;">
                        <span class="aq-rank-pill aq-rank-@(i + 1) tabular">@(i + 1)</span>
                        <div>
                            <div style="font-weight:700;">@team.TeamName</div>
                            <div style="font-size:0.8rem; color:var(--text-secondary);">
                                @team.MemberCount @(team.MemberCount == 1 ? "member" : "members") &middot; Avg @team.AverageScore pts
                            </div>
                        </div>
                    </div>
                    <div class="tabular font-display" style="font-weight:700; font-size:1.05rem;">
                        @team.TotalScore
                    </div>
                </div>
            }
        </div>
    }
    else if (Players.Count == 0)
    {
        <p style="margin:0; color:var(--text-secondary); font-size:0.9rem;">No players have joined yet.</p>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:0.5rem;">
            @foreach (var p in Players.Take(12))
            {
                bool isSelf = HighlightPlayerId == p.PlayerId;
                <div class="aq-leaderboard-row @(isSelf ? "is-self" : "") @(p.IsEliminated ? "is-eliminated" : "")">
                    <div style="display:flex; align-items:center; gap:0.65rem; min-width:0;">
                        <span class="aq-rank-pill aq-rank-@p.Rank tabular">@p.Rank</span>
                        <div style="min-width:0;">
                            <div style="font-weight:700; display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap;">
                                <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@p.Nickname</span>
                                @if (p.CurrentStreak >= 2 && !p.IsEliminated)
                                {
                                    <span class="aq-badge aq-badge-amber tabular">@($"{p.CurrentStreak}x streak")</span>
                                }
                                @if (p.IsEliminated)
                                {
                                    <span class="aq-badge aq-badge-crimson">ELIMINATED</span>
                                }
                                @if (!p.IsConnected)
                                {
                                    <span class="aq-badge aq-badge-neutral">Offline</span>
                                }
                            </div>
                            <div style="font-size:0.78rem; color:var(--text-secondary);" class="tabular">
                                @p.CorrectCount/@p.AnsweredCount correct
                                @if (p.AverageResponseMs > 0)
                                {
                                    <span> &middot; @((p.AverageResponseMs / 1000.0).ToString("F2"))s avg</span>
                                }
                                @if (Mode == GameMode.TeamBattle && p.Team != TeamSide.None)
                                {
                                    <span> &middot; @ScoreEngine.FormatTeamName(p.Team)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div style="text-align:right; flex-shrink:0;">
                        <div class="tabular font-display" style="font-weight:700; font-size:1.05rem;">
                            @p.TotalScore
                        </div>
                        @if (p.LastDeltaScore > 0)
                        {
                            <div class="tabular" style="font-size:0.76rem; font-weight:700; color:var(--emerald-text);">
                                +@p.LastDeltaScore
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<PlayerStandingDto> Players { get; set; } = [];

    [Parameter]
    public IReadOnlyList<TeamStandingDto> Teams { get; set; } = [];

    [Parameter]
    public GameMode Mode { get; set; }

    [Parameter]
    public string? HighlightPlayerId { get; set; }

    private bool _showTeams;
}

