@using ArenaQuiz.Shared.Functional
@using ArenaQuiz.Shared.Models

<section class="aq-card" aria-label="Live leaderboard">
    <div class="aq-row-between aq-mb-md">
        <div>
            <h3 class="aq-heading-md">Live Standings</h3>
            <div class="aq-text-xs">
                @Players.Count @(Players.Count == 1 ? "participant" : "participants")
            </div>
        </div>

        @if (Mode == GameMode.TeamBattle && Teams.Count > 0)
        {
            <div class="aq-row-wrap">
                <button type="button"
                        class="aq-btn aq-btn-sm @(!_showTeams ? "aq-btn-dark" : "aq-btn-secondary")"
                        @onclick="() => _showTeams = false">
                    Players
                </button>
                <button type="button"
                        class="aq-btn aq-btn-sm @(_showTeams ? "aq-btn-dark" : "aq-btn-secondary")"
                        @onclick="() => _showTeams = true">
                    Teams
                </button>
            </div>
        }
    </div>

    @if (_showTeams && Mode == GameMode.TeamBattle && Teams.Count > 0)
    {
        <div class="aq-stack-sm">
            @for (int i = 0; i < Teams.Count; i++)
            {
                var team = Teams[i];
                <div class="aq-leaderboard-row">
                    <div class="aq-row-wrap">
                        <span class="aq-rank-pill aq-rank-@(i + 1) tabular">@(i + 1)</span>
                        <div>
                            <strong>@team.TeamName</strong>
                            <div class="aq-text-xs">
                                @team.MemberCount @(team.MemberCount == 1 ? "member" : "members") &middot; Avg @team.AverageScore pts
                            </div>
                        </div>
                    </div>
                    <div class="aq-score-value tabular">@team.TotalScore</div>
                </div>
            }
        </div>
    }
    else if (Players.Count == 0)
    {
        <p class="aq-text-muted">No players have joined yet.</p>
    }
    else
    {
        <div class="aq-stack-xs">
            @foreach (var p in Players.Take(12))
            {
                bool isSelf = HighlightPlayerId == p.PlayerId;
                <div class="aq-leaderboard-row @(isSelf ? "is-self" : string.Empty) @(p.IsEliminated ? "is-eliminated" : string.Empty)">
                    <div class="aq-row-wrap aq-flex-1">
                        <span class="aq-rank-pill aq-rank-@p.Rank tabular">@p.Rank</span>
                        <div class="aq-flex-1">
                            <div class="aq-row-wrap">
                                <strong class="aq-truncate">@p.Nickname</strong>
                                @if (p.CurrentStreak >= 2 && !p.IsEliminated)
                                {
                                    <span class="aq-badge aq-badge-amber tabular">@($"{p.CurrentStreak}x streak")</span>
                                }
                                @if (p.IsEliminated)
                                {
                                    <span class="aq-badge aq-badge-crimson">ELIMINATED</span>
                                }
                                @if (!p.IsConnected)
                                {
                                    <span class="aq-badge aq-badge-neutral">Offline</span>
                                }
                            </div>
                            <div class="aq-text-xs tabular">
                                @p.CorrectCount/@p.AnsweredCount correct
                                @if (p.AverageResponseMs > 0)
                                {
                                    <span> &middot; @((p.AverageResponseMs / 1000.0).ToString("F2"))s avg</span>
                                }
                                @if (Mode == GameMode.TeamBattle && p.Team != TeamSide.None)
                                {
                                    <span> &middot; @ScoreEngine.FormatTeamName(p.Team)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="aq-score-value tabular">@p.TotalScore</div>
                        @if (p.LastDeltaScore > 0)
                        {
                            <div class="aq-score-delta tabular">+@p.LastDeltaScore</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<PlayerStandingDto> Players { get; set; } = [];

    [Parameter]
    public IReadOnlyList<TeamStandingDto> Teams { get; set; } = [];

    [Parameter]
    public GameMode Mode { get; set; }

    [Parameter]
    public string? HighlightPlayerId { get; set; }

    private bool _showTeams;
}
