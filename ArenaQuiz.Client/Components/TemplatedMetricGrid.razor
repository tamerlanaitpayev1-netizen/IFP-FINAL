@typeparam TItem

<div class="aq-card">
    @if (HeaderTemplate is not null)
    {
        <div class="aq-mb-md">
            @HeaderTemplate
        </div>
    }

    @if (Items is null || Items.Count == 0)
    {
        <div class="aq-card-elevated aq-empty-state">
            @EmptyMessage
        </div>
    }
    else
    {
        <div class="aq-stack-sm">
            @foreach (var item in Items)
            {
                @RowTemplate(item)
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    [Parameter]
    public string EmptyMessage { get; set; } = "No records found.";
}
