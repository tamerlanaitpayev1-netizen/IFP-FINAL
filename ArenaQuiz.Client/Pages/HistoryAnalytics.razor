@page "/analytics"
@inject QuizApiClient Api
@inject GameStateContainer GameState
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc.T("analytics.title") — ArenaQuiz</PageTitle>

<section class="aq-stack-lg">
    <div class="aq-row-between">
        <div>
            <h1 class="aq-heading-lg">@Loc.T("analytics.title")</h1>
            <p class="aq-text-muted">Historical match standings, participant accuracy telemetry, and toughest questions.</p>
        </div>
        @if (_overview?.RecentSessions.Count > 0)
        {
            @if (CanExportCsv)
            {
                <a class="aq-btn aq-btn-secondary aq-btn-sm"
                   href="@BuildExportUrl(_overview.RecentSessions[0].SessionId)"
                   download="arenaquiz-latest.csv">
                    @Loc.T("analytics.export") (Latest)
                </a>
            }
            else
            {
                <a class="aq-btn aq-btn-secondary aq-btn-sm" href="/auth">
                    Sign in as Host to export CSV
                </a>
            }
        }
    </div>

    @if (_loading)
    {
        <div class="aq-grid-4">
            <div class="aq-card aq-skeleton"></div>
            <div class="aq-card aq-skeleton"></div>
            <div class="aq-card aq-skeleton"></div>
            <div class="aq-card aq-skeleton"></div>
        </div>
        <div class="aq-card aq-skeleton-lg"></div>
    }
    else if (_overview is null)
    {
        <div class="aq-alert aq-alert-crimson">Could not retrieve analytics telemetry from the server.</div>
    }
    else
    {
        <div class="aq-grid-4 aq-enter">
            <div class="aq-card">
                <span class="aq-label">Matches Completed</span>
                <div class="aq-kpi-value tabular">@_overview.TotalSessionsPlayed</div>
            </div>
            <div class="aq-card">
                <span class="aq-label">Total Participants</span>
                <div class="aq-kpi-value tabular">@_overview.TotalParticipants</div>
            </div>
            <div class="aq-card">
                <span class="aq-label">Global Accuracy</span>
                <div class="aq-kpi-value tabular">@($"{_overview.GlobalAccuracyPercent:F1}%")</div>
            </div>
            <div class="aq-card">
                <span class="aq-label">Most Played Deck</span>
                <div class="aq-heading-md aq-mt-sm">@_overview.MostPopularQuiz</div>
            </div>
        </div>

        <TemplatedMetricGrid TItem="SessionHistoryDto"
                             Items="@_overview.RecentSessions"
                             EmptyMessage="No finished matches recorded yet. Run a live session in Host Studio to populate history.">
            <HeaderTemplate>
                <div class="aq-row-between">
                    <h2 class="aq-heading-md">Recent Completed Matches</h2>
                    <span class="aq-badge aq-badge-neutral tabular">@_overview.RecentSessions.Count sessions</span>
                </div>
            </HeaderTemplate>

            <RowTemplate Context="session">
                <article class="aq-card aq-card-elevated aq-stack-sm">
                    <div class="aq-row-between">
                        <div class="aq-stack-xs">
                            <div class="aq-row-wrap">
                                <strong>@session.QuizTitle</strong>
                                <span class="aq-badge aq-badge-cobalt">@FormatMode(session.Mode)</span>
                                <span class="aq-badge aq-badge-neutral font-mono-code">PIN @session.RoomCode</span>
                            </div>
                            <span class="aq-text-xs">
                                Host: @session.HostName · Winner: <strong>@session.WinnerNickname</strong> (@session.WinnerScore pts) ·
                                @session.FinishedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </div>
                        <div class="aq-row-wrap">
                            <span class="aq-badge aq-badge-emerald tabular">
                                @($"{session.AverageAccuracyPercent:F1}%") accuracy · @session.ParticipantCount players
                            </span>
                            @if (CanExportCsv)
                            {
                                <a class="aq-btn aq-btn-secondary aq-btn-sm"
                                   href="@BuildExportUrl(session.SessionId)"
                                   download="arenaquiz-@(session.RoomCode).csv">
                                    @Loc.T("analytics.export")
                                </a>
                            }
                            else
                            {
                                <a class="aq-btn aq-btn-secondary aq-btn-sm" href="/auth">
                                    Host Export
                                </a>
                            }
                        </div>
                    </div>

                    @if (session.Results.Count > 0)
                    {
                        <div class="aq-table-wrap">
                            <table class="aq-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Nickname</th>
                                        <th>Team</th>
                                        <th>Score</th>
                                        <th>Correct</th>
                                        <th>Best Streak</th>
                                        <th>Avg Speed</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in session.Results.Take(8))
                                    {
                                        <tr>
                                            <td class="tabular">#@r.FinalRank</td>
                                            <td>
                                                <strong>@r.Nickname</strong>
                                                @if (r.WasEliminated)
                                                {
                                                    <span class="aq-badge aq-badge-crimson">KO</span>
                                                }
                                            </td>
                                            <td>@r.TeamName</td>
                                            <td class="tabular">@r.FinalScore</td>
                                            <td class="tabular">@r.CorrectAnswers/@r.TotalQuestions</td>
                                            <td class="tabular">@($"{r.BestStreak}x")</td>
                                            <td class="tabular">@($"{(r.AverageResponseMs / 1000.0):F2}s")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </RowTemplate>
        </TemplatedMetricGrid>

        @if (_overview.QuestionStats is { Count: > 0 })
        {
            <section class="aq-card aq-stack-sm">
                <div class="aq-row-between">
                    <h2 class="aq-heading-md">@Loc.T("analytics.hardest")</h2>
                    <span class="aq-badge aq-badge-amber">Lowest accuracy first</span>
                </div>

                <div class="aq-table-wrap">
                    <table class="aq-table">
                        <thead>
                            <tr>
                                <th>Quiz</th>
                                <th>Question Prompt</th>
                                <th>Correct / Attempts</th>
                                <th>Accuracy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in _overview.QuestionStats)
                            {
                                <tr>
                                    <td>@stat.QuizTitle</td>
                                    <td>@stat.Prompt</td>
                                    <td class="tabular">@stat.CorrectAttempts / @stat.TotalAttempts</td>
                                    <td class="tabular">
                                        <span class="aq-badge @(stat.AccuracyPercent < 50 ? "aq-badge-crimson" : stat.AccuracyPercent < 75 ? "aq-badge-amber" : "aq-badge-emerald")">
                                            @($"{stat.AccuracyPercent:F1}%")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</section>

@code {
    private AnalyticsOverviewDto? _overview;
    private bool _loading = true;

    private bool CanExportCsv =>
        GameState.CurrentUser.Role is UserRole.Host or UserRole.Admin
        && !string.IsNullOrWhiteSpace(GameState.CurrentUser.Token);

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        GameState.OnStateChanged += HandleLanguageChanged;
        try
        {
            await GameState.TryRestoreAuthSessionAsync();
            _overview = await Api.GetAnalyticsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private string BuildExportUrl(Guid sessionId) =>
        $"api/sessions/{sessionId}/export.csv?access_token={Uri.EscapeDataString(GameState.CurrentUser.Token)}";

    private static string FormatMode(GameMode mode) => mode switch
    {
        GameMode.ClassicSpeed => "Classic Speed",
        GameMode.TeamBattle => "Team Battle",
        GameMode.KnockoutElimination => "Knockout",
        _ => mode.ToString()
    };

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
        GameState.OnStateChanged -= HandleLanguageChanged;
    }
}
