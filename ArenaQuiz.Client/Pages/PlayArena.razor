@page "/play"
@page "/play/{RoomCode}"
@inject GameStateContainer GameState
@inject LocalizationService L
@implements IDisposable

<PageTitle>Play Arena — ArenaQuiz</PageTitle>

<div class="aq-enter aq-stack-lg">
    @if (GameState.CurrentRoom is null)
    {
        <section class="aq-card aq-card-narrow">
            <h1 class="aq-heading-lg">@L.T("play.title")</h1>
            <p class="aq-text-muted aq-mb-md">Join with the 6-character PIN displayed by your host.</p>

            <div class="aq-stack-md">
                <div>
                    <label class="aq-label" for="play-pin">@L.T("home.pin")</label>
                    <input id="play-pin" class="aq-input aq-pin-input" placeholder="AQ4829" maxlength="8" @bind="_pin" />
                </div>

                <div>
                    <label class="aq-label" for="play-nick">@L.T("home.nick")</label>
                    <input id="play-nick" class="aq-input" placeholder="e.g. Dias_Dev" maxlength="24" @bind="_nickname" />
                </div>

                <div>
                    <label class="aq-label" for="play-team">@L.T("home.team")</label>
                    <select id="play-team" class="aq-select" @bind="_team">
                        <option value="@TeamSide.None">Auto-Balance</option>
                        <option value="@TeamSide.Alpha">Team Alpha</option>
                        <option value="@TeamSide.Beta">Team Beta</option>
                        <option value="@TeamSide.Gamma">Team Gamma</option>
                    </select>
                </div>

                <button type="button"
                        class="aq-btn aq-btn-primary"
                        disabled="@GameState.IsBusy"
                        @onclick="JoinAsync">
                    @(GameState.IsBusy ? "Connecting..." : L.T("home.join_btn"))
                </button>
            </div>
        </section>
    }
    else
    {
        var room = GameState.CurrentRoom;
        var me = GameState.CurrentPlayerStanding;

        <div class="aq-card aq-row-between">
            <div>
                <div class="aq-row-wrap">
                    <span class="aq-badge aq-badge-neutral font-mono-code tabular">PIN: @room.RoomCode</span>
                    <span class="aq-badge aq-badge-cobalt">@room.Mode</span>
                    @if (me is not null)
                    {
                        <span class="aq-badge aq-badge-emerald tabular">Score: @me.TotalScore &middot; Rank #@me.Rank</span>
                    }
                </div>
                <strong class="aq-block aq-mt-sm">@room.QuizTitle</strong>
            </div>

            <div class="aq-row-wrap">
                @if (room.Phase == RoomPhase.QuestionActive && room.ActiveQuestion is not null)
                {
                    <RoundTimer RemainingSeconds="room.RemainingSeconds"
                                TotalSeconds="room.ActiveQuestion.TimeLimitSeconds"
                                IsPaused="room.IsPaused" />
                }
                <button type="button" class="aq-btn aq-btn-secondary aq-btn-sm" @onclick="() => GameState.LeaveRoomAsync()">
                    Leave
                </button>
            </div>
        </div>

        @if (GameState.IsEliminated && room.Phase != RoomPhase.PodiumFinished)
        {
            <div class="aq-alert aq-alert-crimson">
                <strong>Eliminated in Knockout Mode.</strong> You are now spectating until the final podium.
            </div>
        }

        @if (room.Phase == RoomPhase.Lobby)
        {
            <section class="aq-card aq-lobby-wait-card">
                <span class="aq-badge aq-badge-amber">@L.T("play.wait")</span>
                <h2 class="aq-heading-lg aq-mt-sm">You are in, @(GameState.CurrentNickname ?? "Player")!</h2>
                <p class="aq-text-muted aq-mb-md">Keep this tab open on your phone or laptop. Questions will appear automatically.</p>

                <div class="aq-row-center aq-mb-md">
                    @foreach (var tag in _reactionTags)
                    {
                        <button type="button"
                                class="aq-btn aq-btn-secondary aq-btn-sm"
                                @onclick="() => GameState.SendReactionAsync(tag)">
                            @tag
                        </button>
                    }
                </div>

                @if (GameState.RecentReactions.Count > 0)
                {
                    <div class="aq-row-center">
                        @foreach (var r in GameState.RecentReactions.TakeLast(6))
                        {
                            <span class="aq-badge aq-badge-neutral">@r.SenderNickname: @r.ReactionKey</span>
                        }
                    </div>
                }
            </section>

            <PlayerRoster Players="room.Players" IsHost="false" Mode="room.Mode" />
        }
        else if (room.Phase is RoomPhase.QuestionActive or RoomPhase.QuestionReveal && room.ActiveQuestion is not null)
        {
            <QuestionCard Question="room.ActiveQuestion"
                          Reveal="room.LastReveal"
                          SelectedOptionIndex="GameState.SelectedOptionIndex"
                          IsDisabled="GameState.IsEliminated || room.IsPaused"
                          OnOptionSelected="idx => GameState.SubmitAnswerAsync(idx)" />

            @if (room.IsPaused && room.Phase == RoomPhase.QuestionActive)
            {
                <div class="aq-alert aq-alert-amber">
                    <strong>Timer Paused</strong> — The host temporarily paused this question.
                </div>
            }

            @if (GameState.HasAnsweredCurrentQuestion && room.Phase == RoomPhase.QuestionActive && GameState.LastAnswerAck is not null)
            {
                <div class="aq-alert aq-alert-cobalt">
                    <span>
                        <strong>@L.T("play.locked")</strong> (@((GameState.LastAnswerAck.ServerElapsedMs / 1000.0).ToString("F2"))s).
                        Waiting for remaining players (@room.AnsweredCount / @Math.Max(1, room.ActivePlayerCount)).
                    </span>
                </div>
            }

            @if (room.Phase == RoomPhase.QuestionReveal)
            {
                <LiveLeaderboard Players="room.Players"
                                 Teams="room.Teams"
                                 Mode="room.Mode"
                                 HighlightPlayerId="GameState.CurrentPlayerId" />
            }
        }
        else if (room.Phase == RoomPhase.PodiumFinished)
        {
            <section class="aq-card aq-podium-celebrate">
                <span class="aq-badge aq-badge-emerald">Game Complete</span>
                <h2 class="aq-heading-lg aq-mt-sm aq-mb-md">Final Standings</h2>
                <LiveLeaderboard Players="room.Players"
                                 Teams="room.Teams"
                                 Mode="room.Mode"
                                 HighlightPlayerId="GameState.CurrentPlayerId" />
            </section>
        }
    }
</div>

@code {
    [Parameter]
    public string? RoomCode { get; set; }

    private string _pin = string.Empty;
    private string _nickname = string.Empty;
    private TeamSide _team = TeamSide.None;
    private readonly string[] _reactionTags = ["Ready!", "Speedrun", "GG", "Let's Go"];

    protected override void OnInitialized()
    {
        GameState.OnStateChanged += HandleStateChanged;
        L.OnLanguageChanged += HandleStateChanged;
        if (!string.IsNullOrWhiteSpace(RoomCode))
        {
            _pin = RoomCode.ToUpperInvariant();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && GameState.CurrentRoom is null)
        {
            await GameState.TryRecoverSessionAsync(RoomCode);
        }
    }

    private async Task JoinAsync()
    {
        if (string.IsNullOrWhiteSpace(_pin) || string.IsNullOrWhiteSpace(_nickname))
        {
            return;
        }
        await GameState.JoinRoomAsync(_pin, _nickname, _team);
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        GameState.OnStateChanged -= HandleStateChanged;
        L.OnLanguageChanged -= HandleStateChanged;
    }
}
