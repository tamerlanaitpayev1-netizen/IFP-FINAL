@page "/"
@inject QuizApiClient Api
@inject GameStateContainer GameState
@inject LocalizationService L
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>ArenaQuiz — Live Real-Time Quiz Platform</PageTitle>

<div class="aq-enter aq-stack-lg">
    <section class="aq-grid-2">
        <div class="aq-card aq-card-split">
            <div>
                <div class="aq-row-wrap aq-mb-sm">
                    <span class="aq-badge aq-badge-accent">@L.T("home.badge.rt")</span>
                    <span class="aq-badge aq-badge-neutral">@L.T("home.badge.stack")</span>
                </div>
                <h1 class="aq-heading-hero">@L.T("home.title")</h1>
                <p class="aq-text-muted">@L.T("home.subtitle")</p>
            </div>

            <div class="aq-row-wrap">
                <a href="host" class="aq-btn aq-btn-dark">@L.T("home.open_host")</a>
                <a href="analytics" class="aq-btn aq-btn-secondary">@L.T("home.view_results")</a>
            </div>
        </div>

        <div class="aq-card">
            <h2 class="aq-heading-md aq-mb-md">@L.T("home.join_title")</h2>
            <div class="aq-stack-md">
                <div>
                    <label class="aq-label" for="home-pin">@L.T("home.pin")</label>
                    <input id="home-pin"
                           class="aq-input aq-pin-input"
                           placeholder="AQ4829"
                           maxlength="8"
                           @bind="_roomCode"
                           @bind:event="oninput" />
                </div>

                <div class="aq-grid-2">
                    <div>
                        <label class="aq-label" for="home-nick">@L.T("home.nick")</label>
                        <input id="home-nick"
                               class="aq-input"
                               placeholder="e.g. Amina_CS"
                               maxlength="24"
                               @bind="_nickname" />
                    </div>
                    <div>
                        <label class="aq-label" for="home-team">@L.T("home.team")</label>
                        <select id="home-team" class="aq-select" @bind="_preferredTeam">
                            <option value="@TeamSide.None">Auto-Balance</option>
                            <option value="@TeamSide.Alpha">Team Alpha</option>
                            <option value="@TeamSide.Beta">Team Beta</option>
                            <option value="@TeamSide.Gamma">Team Gamma</option>
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_joinError))
                {
                    <div class="aq-alert aq-alert-crimson">@_joinError</div>
                }

                <button type="button"
                        class="aq-btn aq-btn-primary"
                        disabled="@_isJoining"
                        @onclick="JoinFromHomeAsync">
                    @(_isJoining ? "Connecting..." : L.T("home.join_btn"))
                </button>
            </div>
        </div>
    </section>

    <section class="aq-card">
        <div class="aq-row-between aq-mb-md">
            <div>
                <h2 class="aq-heading-md">@L.T("home.open_rooms")</h2>
                <div class="aq-text-xs">Select a room to pre-fill its PIN and join immediately.</div>
            </div>
            <button type="button" class="aq-btn aq-btn-secondary aq-btn-sm" @onclick="RefreshOpenRoomsAsync">
                @L.T("home.refresh")
            </button>
        </div>

        @if (_openRooms.Count == 0)
        {
            <div class="aq-card-elevated aq-row-between">
                <span class="aq-text-muted">No live rooms are open right now. Launch one in Host Studio.</span>
                <a href="host" class="aq-btn aq-btn-primary aq-btn-sm">@L.T("home.open_host")</a>
            </div>
        }
        else
        {
            <div class="aq-grid-3">
                @foreach (var room in _openRooms)
                {
                    <div class="aq-card-elevated aq-card-split">
                        <div>
                            <div class="aq-row-between">
                                <span class="font-mono-code tabular">@room.RoomCode</span>
                                <span class="aq-badge aq-badge-emerald">@room.Phase</span>
                            </div>
                            <strong class="aq-block aq-mt-sm">@room.QuizTitle</strong>
                            <div class="aq-text-xs">
                                Host: @room.HostName &middot; @room.PlayerCount players &middot; @room.Mode
                            </div>
                        </div>
                        <button type="button"
                                class="aq-btn aq-btn-dark aq-btn-sm"
                                @onclick="() => SelectRoomPin(room.RoomCode)">
                            Use PIN @room.RoomCode
                        </button>
                    </div>
                }
            </div>
        }
    </section>

    <section class="aq-card">
        <h2 class="aq-heading-md aq-mb-md">@L.T("home.library") (@_quizzes.Count)</h2>
        <div class="aq-grid-3">
            @foreach (var quiz in _quizzes)
            {
                <div class="aq-card-elevated aq-card-split">
                    <div>
                        <span class="aq-badge aq-badge-cobalt">@quiz.Category</span>
                        <h3 class="aq-heading-md aq-mt-sm">@quiz.Title</h3>
                        <p class="aq-text-muted">@quiz.Description</p>
                    </div>
                    <div class="aq-row-between aq-text-xs tabular">
                        <span>@quiz.QuestionCount questions &middot; ~@quiz.DefaultTimeLimitSeconds s</span>
                        <span>by @quiz.CreatedBy</span>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string _roomCode = string.Empty;
    private string _nickname = string.Empty;
    private TeamSide _preferredTeam = TeamSide.None;
    private string? _joinError;
    private bool _isJoining;
    private IReadOnlyList<OpenRoomSummaryDto> _openRooms = [];
    private IReadOnlyList<QuizSummaryDto> _quizzes = [];

    protected override async Task OnInitializedAsync()
    {
        L.OnLanguageChanged += OnLangChanged;
        await RefreshOpenRoomsAsync();
        _quizzes = await Api.GetQuizzesAsync();
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private async Task RefreshOpenRoomsAsync()
    {
        try
        {
            _openRooms = await Api.GetOpenRoomsAsync();
        }
        catch
        {
            _openRooms = [];
        }
    }

    private void SelectRoomPin(string code) => _roomCode = code;

    private async Task JoinFromHomeAsync()
    {
        _joinError = null;
        if (string.IsNullOrWhiteSpace(_roomCode))
        {
            _joinError = "Enter a room PIN (e.g., AQ4829).";
            return;
        }

        if (string.IsNullOrWhiteSpace(_nickname) || _nickname.Trim().Length < 2)
        {
            _joinError = "Enter a nickname (at least 2 characters).";
            return;
        }

        _isJoining = true;
        var res = await GameState.JoinRoomAsync(_roomCode, _nickname, _preferredTeam);
        _isJoining = false;

        if (res.IsSuccess)
        {
            Navigation.NavigateTo("play");
        }
        else
        {
            _joinError = res.Error ?? "Could not join room.";
        }
    }

    public void Dispose() => L.OnLanguageChanged -= OnLangChanged;
}
